{
  "name": "evalforge-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,html,ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,html,ts,js}\""
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.28.0",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.0",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
